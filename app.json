{
  "expo": {
    "name": "bookcycle",
    "slug": "bookcycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/B.png",
    "scheme": "bookcycle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icons/B.png",
        "backgroundImage": "./assets/images/icons/B.png",
        "monochromeImage": "./assets/images/icons/B.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hudaidajmal.bookcycle"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/B.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icons/B.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acfbef33-1290-485e-8676-08bec811d14e"
      }
    }
  }
}
